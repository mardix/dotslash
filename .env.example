# Copy to .env and edit:  cp .env.example .env

# The first admin, created on the first start. After that, people and
# passwords are managed in the app (Settings → Users / Profile).
DS_USER=admin
DS_PASSWORD=change-me

# Optional: key that signs session cookies. If empty, one is generated and
# kept in the database. Set it only if you want to choose it yourself.
DS_SECRET=

# true when running behind a reverse proxy (Caddy, nginx, Traefik)
DS_TRUST_PROXY=false

# Time zone for logs and backup names
TZ=America/New_York
